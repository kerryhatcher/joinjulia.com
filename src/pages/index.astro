---
import '../styles/global.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import { Image } from 'astro:assets';
import headshot from '../../public/images/headshot.jpg';
import speaking from '../../public/images/475563222_18483407191023500_1833185274346487540_n.jpg';
import meeting from '../../public/images/526597981_18518407303023500_453408748168898313_n.jpg';
import Arrow from '../components/Arrow.astro';
import ContactForm from '../components/ContactForm.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const canonicalUrl = new URL(base, Astro.site);
const title = 'Julia Adele Callahan — Bibb County Democratic Party Chair Candidate';
const description = 'Meet Julia Adele Callahan, candidate for Bibb County Democratic Party Chair in Macon, Georgia. Explore her story, priorities, and writing. Democrats on offense.';
const socialImage = new URL(`${base}images/social-card.png`, Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${canonicalUrl.href}#website`,
      url: canonicalUrl.href,
      name: 'Join Julia',
      alternateName: 'Julia Adele Callahan',
      inLanguage: 'en-US',
      about: { '@id': `${canonicalUrl.href}#julia` },
    },
    {
      '@type': 'Person',
      '@id': `${canonicalUrl.href}#julia`,
      name: 'Julia Adele Callahan',
      url: canonicalUrl.href,
      description: 'Candidate for Bibb County Democratic Party Chair in Macon, Georgia.',
      sameAs: [
        'https://www.facebook.com/JuliaAdeleCallahan/',
        'https://www.instagram.com/jaythaqueen/',
        'https://www.threads.com/@jaythaqueen',
        'https://msmagazine.com/author/jcallahan/',
        'https://georgiarecorder.com/author/juliacallhan/',
      ],
    },
  ],
};

const priorities = [
  { title: 'Jail & public safety reform', id: 'public-safety' },
  { title: 'Election accessibility', id: 'elections' },
  { title: 'Healthcare', id: 'healthcare' },
  { title: 'Education', id: 'education' },
];
const reading = [
  { publication: 'Ms. Magazine', title: 'Julia’s writing on reproductive rights', href: 'https://msmagazine.com/author/jcallahan/' },
  { publication: 'Georgia Recorder', title: 'More from Julia’s perspective', href: 'https://georgiarecorder.com/author/juliacallhan/' },
  { publication: 'Center for American Progress Action', title: 'The cost of child care for Georgia families', href: 'https://www.americanprogressaction.org/article/without-child-tax-credit-some-georgia-parents-must-leave-workforce-to-care-for-their-children/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#103ca6" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Join Julia" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Julia Adele Callahan. Democrats on offense. For Bibb County Democratic Party Chair in Macon, Georgia." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <meta name="twitter:image:alt" content="Julia Adele Callahan. Democrats on offense. For Bibb County Democratic Party Chair in Macon, Georgia." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preload" href={`${base}fonts/julia-playbook.otf`} as="font" type="font/otf" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Join Julia home">joinjulia.com</a>
      <nav aria-label="Main navigation"><a href="#my-story">My story</a><a href="#priorities">Priorities</a></nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="campaign-heading">
        <div class="hero-layout">
          <div class="hero-copy">
            <h1 id="campaign-heading"><span>Democrats</span><span>on offense</span><span class="candidate-name">Julia Adele Callahan</span></h1>
            <p class="candidate-office">For Bibb County Democratic Party Chair</p>
            <a class="primary-action" href="#priorities">Explore the priorities <Arrow /></a>
          </div>
          <div class="hero-media">
            <img class="play-diagram" src={`${base}images/offensive-playbook.webp`} width="1469" height="1071" alt="" decoding="async" />
            <Image class="hero-portrait" src={headshot} widths={[360, 540, 720, 960]} sizes="(max-width: 760px) calc(100vw - 80px), (max-width: 1100px) 36vw, 440px" width={960} height={960} format="webp" quality={85} alt="Julia Adele Callahan smiling in a black blazer against a dark background." loading="eager" fetchpriority="high" />
          </div>
        </div>
      </section>
      <section class="playbook section-shell" id="priorities" aria-labelledby="playbook-heading">
        <div class="section-heading"><h2 id="playbook-heading">The playbook</h2><span class="heading-rule" aria-hidden="true"></span></div>
        <div class="priority-list">
          {priorities.map((priority, index) => (
            <details class="priority" name="playbook" id={priority.id}>
              <summary><span class="play-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span class="priority-title">{priority.title}</span><Arrow /></summary>
              <div class="priority-content"><p>Julia’s full priority statement is coming soon. Follow along as the campaign playbook takes shape.</p><a class="text-link" href="https://www.facebook.com/JuliaAdeleCallahan/" target="_blank" rel="noopener noreferrer">Follow Julia on Facebook <Arrow /></a></div>
            </details>
          ))}
        </div>
      </section>
      <section class="stories" id="my-story" aria-labelledby="story-heading">
        <div class="story-index section-shell">
          <h2 id="story-heading">My story</h2>
          <a href="#business-story">How my business started <Arrow /></a>
          <a href="#politics-story">My journey into politics <Arrow /></a>
        </div>
        <div class="story-passages section-shell">
          <article class="story-passage" id="business-story" aria-labelledby="business-heading">
            <h3 id="business-heading">How my business started</h3>
            <div class="story-copy">
              <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
              <p>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
              <a class="text-link" href="https://www.facebook.com/p/Dream-Clean-Housekeeping-Company-LLC-61550656630177" target="_blank" rel="noopener noreferrer">Visit Dream Clean <Arrow /></a>
            </div>
          </article>
          <article class="story-passage" id="politics-story" aria-labelledby="politics-heading">
            <div class="story-visual">
              <h3 id="politics-heading">My journey into politics</h3>
              <figure class="speaking-photo">
                <Image src={speaking} widths={[360, 540, 720, 960]} sizes="(max-width: 760px) calc(100vw - 40px), 36vw" width={720} height={900} format="webp" alt="A woman speaks at a microphone, with two women behind her and a blue reproductive-freedom backdrop." loading="lazy" />
                <figcaption>Speaking at a lectern marked “Fighting for Reproductive Freedom.”</figcaption>
              </figure>
            </div>
            <div class="story-copy">
              <p>When I was pregnant, I visited a center in Macon offering free ultrasounds. I thought I was getting medical care. Instead, staff told me something was wrong with my baby’s kidneys, information my OB-GYN later confirmed was incorrect. What I had walked into was a crisis pregnancy center, or “fake clinic.” I left frightened about a problem that wasn’t there.</p>
              <p>That experience pushed me into political action. I began speaking out about fake clinics and the barriers families face when seeking reproductive health care. As a cofounder of Middle Georgia 4 Choice, I’ve shared my story publicly, including at Georgia’s State Capitol. Families deserve accurate information, trustworthy care, and leaders who listen when something goes wrong.</p>
              <a class="text-link" href="https://msmagazine.com/author/jcallahan/" target="_blank" rel="noopener noreferrer">Read Julia’s writing <Arrow /></a>
              <figure class="meeting-photo">
                <Image src={meeting} widths={[480, 720, 1000, 1290]} sizes="(max-width: 760px) calc(100vw - 40px), 48vw" width={1290} height={1720} format="webp" alt="A woman gestures during a discussion with Sen. Raphael Warnock, seated at left beneath the Georgia state seal." loading="lazy" />
                <figcaption>A discussion with Sen. Raphael Warnock.</figcaption>
              </figure>
            </div>
          </article>
        </div>
      </section>
      <section class="reading section-shell" aria-labelledby="reading-heading">
        <div class="section-heading"><h2 id="reading-heading">Beyond the sidelines</h2><span class="heading-rule" aria-hidden="true"></span></div>
        <p class="reading-intro">Julia’s writing and stories from the community. Get to know the person behind the campaign.</p>
        <div class="reading-list">
          {reading.map(item => (
            <a class="reading-item" href={item.href} target="_blank" rel="noopener noreferrer"><span class="publication">{item.publication}</span><span class="reading-title">{item.title}</span><Arrow /></a>
          ))}
        </div>
      </section>
      <section class="campaign-close" aria-labelledby="close-heading">
        <div class="close-layout section-shell">
          <h2 id="close-heading">It’s time to<br />make things happen.</h2>
          <div class="close-copy"><p>It’s time for a change. Let’s put Democrats on offense, right here in Bibb County.</p><a class="primary-action" href="#contact">Connect with Julia <Arrow /></a></div>
        </div>
      </section>
      <ContactForm />
    </main>
    <footer class="site-footer section-shell">
      <div><a class="wordmark" href={base}>joinjulia.com</a><p>Julia Adele Callahan<br />For Bibb County Democratic Party Chair<br />Macon, Georgia</p></div>
      <nav aria-label="Contact and social links"><a href="#contact">Contact Julia <Arrow /></a><a href="https://www.facebook.com/JuliaAdeleCallahan/" target="_blank" rel="noopener noreferrer">Facebook <Arrow /></a><a href="https://www.instagram.com/jaythaqueen/" target="_blank" rel="noopener noreferrer">Instagram <Arrow /></a><a href="https://www.threads.com/@jaythaqueen" target="_blank" rel="noopener noreferrer">Threads <Arrow /></a></nav>
      <a class="back-top" href="#main">Back to the playbook <Arrow /></a>
    </footer>
  </body>
</html>
