---
import '../styles/global.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import { Image } from 'astro:assets';
import headshot from '../../public/images/headshot.jpg';
import speaking from '../../public/images/475563222_18483407191023500_1833185274346487540_n.jpg';
import businessPhoto from '../../public/images/dream-clean-group.jpg';
import playbookGraphic from '../../public/images/offensive-playbook.webp';
import Arrow from '../components/Arrow.astro';
import ContactForm from '../components/ContactForm.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const canonicalUrl = new URL(base, Astro.site);
const title = 'Julia Adele Callahan — Bibb County Democratic Party Chair Candidate';
const description = 'Meet Julia Adele Callahan, candidate for Bibb County Democratic Party Chair in Macon, Georgia. Explore her story, priorities, and writing. Democrats on offense.';
const socialImage = new URL(`${base}images/social-card.png`, Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${canonicalUrl.href}#website`,
      url: canonicalUrl.href,
      name: 'Join Julia',
      alternateName: 'Julia Adele Callahan',
      inLanguage: 'en-US',
      about: { '@id': `${canonicalUrl.href}#julia` },
    },
    {
      '@type': 'Person',
      '@id': `${canonicalUrl.href}#julia`,
      name: 'Julia Adele Callahan',
      url: canonicalUrl.href,
      description: 'Candidate for Bibb County Democratic Party Chair in Macon, Georgia.',
      sameAs: [
        'https://www.facebook.com/JuliaAdeleCallahan/',
        'https://www.instagram.com/jaythaqueen/',
        'https://www.threads.com/@jaythaqueen',
        'https://msmagazine.com/author/jcallahan/',
        'https://georgiarecorder.com/author/juliacallhan/',
      ],
    },
  ],
};

const priorities = [
  {
    "title": "Jail & public safety reform",
    "id": "public-safety",
    "copy": "Our justice system should be rooted in accountability. I’m calling for quarterly public updates on county justice programs, objective numbers that show what is working, and a fully budgeted plan for a new jail facility. Community members deserve a place at the decision-making table.",
    "source": "https://wgxa.tv/news/local/we-cant-just-sit-here-and-wait-bibb-dems-push-for-jail-transparency-after-deaths",
    "sourceLabel": "Read the jail transparency reporting"
  },
  {
    "title": "Election accessibility",
    "id": "elections",
    "copy": "Every eligible voter deserves a voice. I’ve opposed voter registration challenges that disproportionately affect students, people of color, and people without stable housing. I’ve also worked to expand early voting and rebuild our get-out-the-vote infrastructure, with programs like Spooky Voting and Knock Your Block. Protecting the vote and turning out our neighbors go hand in hand.",
    "source": "https://www.facebook.com/JuliaAdeleCallahan/posts/pfbid0k2ryEf5AL7gvzGbBSn4dCaKgSXKefoRhJh2vA6z7dp99k4UhGmGe1nkNm38BttvDl",
    "sourceLabel": "Read my voting access post"
  },
  {
    "title": "Healthcare",
    "id": "healthcare",
    "copy": "Families deserve accurate information and trustworthy reproductive care. Being denied miscarriage care brought me into politics and led me to cofound Middle Georgia 4 Choice. I’ve spoken out about barriers to care and the maternal health crisis in Macon-Bibb, especially for Black women. Mothers and babies deserve better.",
    "source": "https://www.facebook.com/JuliaAdeleCallahan/posts/pfbid035GzJ2hZgqZzenWTXjLm5Uq934s4wz4KXANKjjC3kKR2gpzqqjHBftNkXfSgWULxLl",
    "sourceLabel": "Read my maternal health post"
  },
  {
    "title": "Education",
    "id": "education",
    "copy": "Children deserve a safe, inclusive environment to learn and grow. I’ve called for an end to the harassment and mistreatment of transgender children, and spoken against legislation that targets children and families because they don’t fit the traditional gender binary. Protecting young people means taking bullying seriously and respecting who they are.",
    "source": "https://www.facebook.com/JuliaAdeleCallahan/posts/pfbid02hv7HVdrKQmUZBMFoG4km2nt6G8DJBZs8saj931fSpqCqj8uUh4mHapmTigUwYPPyl",
    "sourceLabel": "Read my post on protecting children"
  }
];
const reading = [
  { publication: 'Ms. Magazine', title: 'Julia’s writing on reproductive rights', href: 'https://msmagazine.com/author/jcallahan/' },
  { publication: 'Georgia Recorder', title: 'More from Julia’s perspective', href: 'https://georgiarecorder.com/author/juliacallhan/' },
  { publication: 'Center for American Progress Action', title: 'The cost of child care for Georgia families', href: 'https://www.americanprogressaction.org/article/without-child-tax-credit-some-georgia-parents-must-leave-workforce-to-care-for-their-children/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#103ca6" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Join Julia" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Julia Adele Callahan. Democrats on offense. For Bibb County Democratic Party Chair in Macon, Georgia." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <meta name="twitter:image:alt" content="Julia Adele Callahan. Democrats on offense. For Bibb County Democratic Party Chair in Macon, Georgia." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preload" href={`${base}fonts/julia-playbook.otf`} as="font" type="font/otf" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Join Julia home">joinjulia.com</a>
      <nav aria-label="Main navigation"><a href="#my-story">My story</a><a href="#priorities">Priorities</a></nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="campaign-heading">
        <div class="hero-layout">
          <div class="hero-copy">
            <h1 id="campaign-heading"><span>Democrats</span><span>on offense</span><span class="candidate-name">Julia Adele Callahan</span></h1>
            <p class="candidate-office">For Bibb County Democratic Party Chair</p>
            <a class="primary-action" href="#my-story">Read Julia’s story <Arrow /></a>
          </div>
          <div class="hero-media">
            <Image class="play-diagram" src={playbookGraphic} widths={[360, 540, 720, 1080, 1469]} sizes="(max-width: 560px) calc(100vw - 40px), (max-width: 760px) 520px, (min-width: 1680px) 712px, 43vw" width={1469} height={1071} format="webp" quality={85} alt="" decoding="async" loading="eager" />
          </div>
        </div>
      </section>
      <section class="playbook section-shell" id="priorities" aria-labelledby="playbook-heading">
        <div class="section-heading"><h2 id="playbook-heading">The playbook</h2><span class="heading-rule" aria-hidden="true"></span></div>
        <p class="playbook-intro">Accountable local government. A voice for every voter. Care families can trust. A safe place for every child to learn.</p>
        <div class="priority-list">
          {priorities.map((priority, index) => (
            <details class="priority" name="playbook" id={priority.id}>
              <summary><span class="play-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span class="priority-title">{priority.title}</span><Arrow /></summary>
              <div class="priority-content"><p>{priority.copy}</p><a class="text-link" href={priority.source} target="_blank" rel="noopener noreferrer">{priority.sourceLabel} <Arrow /></a></div>
            </details>
          ))}
        </div>
      </section>
      <section class="stories" id="my-story" aria-labelledby="story-heading">
          <div class="story-index section-shell">
            <Image class="story-portrait" src={headshot} widths={[260, 360, 520, 720]} sizes="(max-width: 760px) 96px, 160px" width={720} height={720} format="webp" quality={85} alt="Julia Adele Callahan smiling in a black blazer against a dark background." loading="lazy" />
            <div class="story-navigation">
              <h2 id="story-heading">My story</h2>
              <a href="#politics-story">My journey into politics <Arrow /></a>
              <a href="#business-story">How my business started <Arrow /></a>
            </div>
          </div>
        <div class="story-passages section-shell">
          <article class="story-passage" id="politics-story" aria-labelledby="politics-heading">
            <div class="story-visual">
              <figure class="speaking-photo">
                <Image src={speaking} widths={[360, 540, 720, 960]} sizes="(max-width: 760px) calc(100vw - 40px), 36vw" width={720} height={900} format="webp" alt="A woman speaks at a microphone, with two women behind her and a blue reproductive-freedom backdrop." loading="lazy" />
                <figcaption>Speaking at a lectern marked “Fighting for Reproductive Freedom.”</figcaption>
              </figure>
            </div>
            <div class="story-copy">
              <h3 id="politics-heading">My journey into politics</h3>
              <p>I got into politics after being denied miscarriage care while Georgia’s six-week abortion ban was being litigated. I cofounded Middle Georgia 4 Choice, then spent the last two years helping rebuild our local Democratic Party.</p>
              <p>Now I’m ready for the next generation to lead—and to put Democrats on offense.</p>
              <a class="text-link" href={`${base}my-journey-into-politics/`}>Read my journey into politics <Arrow /></a>
            </div>
          </article>
          <article class="story-passage" id="business-story" aria-labelledby="business-heading">
            <div class="story-visual">
              <figure class="business-photo">
                <Image src={businessPhoto} widths={[360, 540, 720, 960]} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1400px) 36vw, 460px" width={720} format="webp" alt="Three people in blue and black work uniforms, with a Dream Clean flyer." loading="lazy" />
                <figcaption>Dream Clean Housekeeping Company.</figcaption>
              </figure>
            </div>
            <div class="story-copy">
              <h3 id="business-heading">How my business started</h3>
              <p>My dad was kind, funny, and always there for me. He loved people unconditionally and never hesitated to tell them. In January 2023, he died by suicide. I miss him deeply, and the love he modeled continues to shape how I care for others.</p>
              <p>After his death, I had to care for my sibling and my young children. Between childcare and my family’s other needs, a traditional job wasn’t possible. I started Dream Clean Housekeeping Company in June 2023 to earn a living with the flexibility my family needed.</p>
              <p>That experience is why supporting mothers, families, mental health, and small businesses matters so much to me. I know what it means to balance caring for the people you love with making a living. My business grew out of those responsibilities, and they continue to shape what I stand for.</p>
              <a class="text-link" href="https://www.dreamcleanmacon.com/" target="_blank" rel="noopener noreferrer">Visit Dream Clean <Arrow /></a>
            </div>
          </article>
        </div>
      </section>
      <section class="reading section-shell" aria-labelledby="reading-heading">
        <div class="section-heading"><h2 id="reading-heading">Beyond the sidelines</h2><span class="heading-rule" aria-hidden="true"></span></div>
        <p class="reading-intro">Julia’s writing and stories from the community. Get to know the person behind the campaign.</p>
        <div class="reading-list">
          {reading.map(item => (
            <a class="reading-item" href={item.href} target="_blank" rel="noopener noreferrer"><span class="publication">{item.publication}</span><span class="reading-title">{item.title}</span><Arrow /></a>
          ))}
        </div>
      </section>
      <section class="campaign-close" aria-labelledby="close-heading">
        <div class="close-layout section-shell">
          <h2 id="close-heading">It’s time to<br />make things happen.</h2>
          <div class="close-copy"><p>It’s time for the next generation to lead. Let’s put Democrats on offense, right here in Bibb County.</p><a class="primary-action" href="#contact">Connect with Julia <Arrow /></a></div>
        </div>
      </section>
      <ContactForm />
    </main>
    <footer class="site-footer section-shell">
      <div><a class="wordmark" href={base}>joinjulia.com</a><p>Julia Adele Callahan<br />For Bibb County Democratic Party Chair<br />Macon, Georgia</p></div>
      <nav aria-label="Contact and social links"><a href="#contact">Contact Julia <Arrow /></a><a href="https://www.facebook.com/JuliaAdeleCallahan/" target="_blank" rel="noopener noreferrer">Facebook <Arrow /></a><a href="https://www.instagram.com/jaythaqueen/" target="_blank" rel="noopener noreferrer">Instagram <Arrow /></a><a href="https://www.threads.com/@jaythaqueen" target="_blank" rel="noopener noreferrer">Threads <Arrow /></a></nav>
      <a class="back-top" href="#main">Back to the playbook <Arrow /></a>
    </footer>
</body>
</html>
